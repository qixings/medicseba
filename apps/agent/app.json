{
  "expo": {
    "name": "MedicSeba Counter",
    "slug": "medicseba-counter",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "in.medicseba.counter",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "in.medicseba.counter"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "scheme": "medicsebacounter",
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/agent"
    },
    "splash": {
      "backgroundColor": "#1ACDD4",
      "resizeMode": "contain",
      "image": "./assets/splash-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-image"
    ]
  }
}